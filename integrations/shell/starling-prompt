#!/bin/sh
# starling-prompt — a tiny POSIX wrapper so the helper can sit on $PATH or behind a symlink.
#
#   ln -s "$PWD/integrations/shell/starling-prompt" ~/bin/starling-prompt
#
# Resolving symlinks by hand (rather than `readlink -f`, which macOS lacks) keeps the shim working from
# a dotfiles repo, a Homebrew-style shim directory, or the checkout itself.
set -u

target=$0
while [ -L "$target" ]; do
  link_dir=$(CDPATH= cd -- "$(dirname "$target")" && pwd) || exit 1
  target=$(readlink "$target") || exit 1
  case $target in
    /*) ;;
    *) target=$link_dir/$target ;;
  esac
done
here=$(CDPATH= cd -- "$(dirname "$target")" && pwd) || exit 1

if ! command -v bun >/dev/null 2>&1; then
  echo "starling-prompt: bun is not on PATH (install Bun 1.3+ from https://bun.sh)" >&2
  exit 127
fi

exec bun "$here/starling-prompt.ts" "$@"
